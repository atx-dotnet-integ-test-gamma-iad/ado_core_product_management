# Example Environment Variables for AdoCore Application
# Copy this file to .env and update with your actual credentials
# IMPORTANT: Never commit the .env file with actual credentials to version control

# Development Connection String
# Format: Host=<host>;Port=<port>;Database=<database>;Username=<username>;Password=<password>;Pooling=true
ConnectionStrings__DevConnection=Host=localhost;Port=5432;Database=ProductManagement;Username=YOUR_DEV_USERNAME;Password=YOUR_DEV_PASSWORD;Pooling=true

# Production Connection String (if running in production mode)
ConnectionStrings__ProdConnection=Host=YOUR_PROD_HOST;Port=5432;Database=ProductManagement;Username=YOUR_PROD_USERNAME;Password=YOUR_PROD_PASSWORD;Pooling=true;SSL Mode=Require

# Environment Setting (Development or Production)
Environment=Development

# Instructions:
# 1. Replace YOUR_DEV_USERNAME, YOUR_DEV_PASSWORD with your actual PostgreSQL credentials
# 2. Replace YOUR_PROD_HOST, YOUR_PROD_USERNAME, YOUR_PROD_PASSWORD with production values
# 3. On Linux/macOS: source this file before running the application (source .env)
# 4. On Windows: Set each variable individually in your environment
# 5. For Docker: Pass these as environment variables in docker-compose.yml or docker run command
