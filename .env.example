# PostgreSQL Database Configuration
# Copy this file to .env and fill in your actual values
# Do not commit .env file to source control

# Override connection strings using environment variables
# Format: ConnectionStrings__<ConnectionName>=<FullConnectionString>

# Development Connection String
ConnectionStrings__DevConnection=Host=localhost;Port=5432;Database=ProductManagement;Username=postgres;Password=YOUR_DEV_PASSWORD;Pooling=true

# Production Connection String
ConnectionStrings__ProdConnection=Host=your-prod-host;Port=5432;Database=ProductManagement;Username=postgres;Password=YOUR_PROD_PASSWORD;Pooling=true

# Alternative: Set individual components (requires custom configuration code)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ProductManagement
# DB_USER=postgres
# DB_PASSWORD=your_password_here
