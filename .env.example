# PostgreSQL Database Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with actual credentials to version control

# Database Host (e.g., localhost, db.example.com)
DB_HOST=localhost

# Database Port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database Name
DB_NAME=ProductManagement

# Database Username
DB_USERNAME=your_username_here

# Database Password
DB_PASSWORD=your_password_here

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholder values with your actual database credentials
# 3. Ensure .env is in .gitignore to prevent committing secrets
# 4. For production, use a secure secrets management solution (Azure Key Vault, AWS Secrets Manager, etc.)
