# PostgreSQL Database Configuration
# Copy this file to .env and update with your actual credentials
# IMPORTANT: Never commit .env file to version control

# Database Connection Settings
DatabaseSettings__Host=localhost
DatabaseSettings__Port=5432
DatabaseSettings__Database=ProductManagement
DatabaseSettings__Username=your_username_here
DatabaseSettings__Password=your_password_here

# Alternative: Override entire connection strings
# ConnectionStrings__DevConnection=Host=localhost;Port=5432;Database=ProductManagement;Username=your_username;Password=your_password
# ConnectionStrings__ProdConnection=Host=production-host;Port=5432;Database=ProductManagement;Username=your_username;Password=your_password
